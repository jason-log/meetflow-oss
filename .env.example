# MeetFlow v0.2 환경 변수 — start.sh / start.bat 이 처음 실행될 때 이 파일을 .env 로 복사하고
# __GENERATE__ 자리를 난수로 채운다. .env 는 절대 git·메일·메신저로 공유하지 않는다.

# development(로컬) | production(운영 서버)
MEETFLOW_ENV=development
PORT=3000

# LiveKit API 키/시크릿 (시크릿 32자 이상)
LIVEKIT_API_KEY=__GENERATE__
LIVEKIT_API_SECRET=__GENERATE__

# 회의를 만들 수 있는 내부 담당자용 호스트 코드 (외부 위원에게 주지 않는다)
HOST_ACCESS_CODE=__GENERATE__

# 브라우저가 접속할 LiveKit 주소
#  로컬: ws://localhost:7880   운영: wss://livekit.<도메인>
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# LiveKit 이 참가자에게 알려 줄 미디어 IP
#  로컬: 127.0.0.1   운영: 서버 공인 IP (예: 203.0.113.10)
LIVEKIT_NODE_IP=127.0.0.1

# 백엔드(3000)·시그널링(7880) 포트를 묶을 주소. 로컬·운영 모두 127.0.0.1 유지(운영은 Caddy가 외부 수신)
LOCAL_BIND=127.0.0.1

# 운영: Caddy 뒤에서 실제 접속자 IP를 쓰기 위해 1, 로컬: 0
TRUST_PROXY=0

MAX_PARTICIPANTS=20
ROOM_TTL_HOURS=24

# 운영 도메인 (docker compose --profile prod 에서 사용)
APP_DOMAIN=meet.example.com
LIVEKIT_DOMAIN=livekit.example.com

# ---- TURN/TLS 443 확장(선택, docker-compose.turn.yml 과 함께 쓸 때만) ----
# 기관망(UDP·비표준 포트 차단) 참가자용 중계 도메인. DNS A 레코드를 같은 공인 IP로 추가한다.
TURN_DOMAIN=turn.example.com
# Caddy 가 발급한 인증서 위치(기본 Let's Encrypt). ZeroSSL 로 발급됐다면 .../acme.zerossl.com-v2-dv90 로 바꾼다.
TURN_CERT_DIR=/caddy-data/caddy/certificates/acme-v02.api.letsencrypt.org-directory
