# MeetFlow v0.2 environment variables — on first run, start.sh / start.bat copy this file to .env
# and replace each __GENERATE__ with a random value. Never share .env through git, email or chat.

# development (local) | production (server)
MEETFLOW_ENV=development
PORT=3000

# LiveKit API key / secret (secret: 32+ characters)
LIVEKIT_API_KEY=__GENERATE__
LIVEKIT_API_SECRET=__GENERATE__

# Host code that lets your own staff create meetings (do not give it to guests)
HOST_ACCESS_CODE=__GENERATE__

# LiveKit address the browser connects to
#  local: ws://localhost:7880   production: wss://livekit.<your-domain>
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# Media IP that LiveKit advertises to participants
#  local: 127.0.0.1   production: the server's public IP (e.g. 203.0.113.10)
LIVEKIT_NODE_IP=127.0.0.1

# Address the backend (3000) and signaling (7880) ports bind to. Keep 127.0.0.1 locally and in production (Caddy handles outside traffic)
LOCAL_BIND=127.0.0.1

# production: 1, so the real client IP is used behind Caddy; local: 0
TRUST_PROXY=0

MAX_PARTICIPANTS=20
ROOM_TTL_HOURS=24

# Production hostnames (used by docker compose --profile prod)
APP_DOMAIN=meet.example.com
LIVEKIT_DOMAIN=livekit.example.com

# ---- TURN/TLS on 443 (optional, only together with docker-compose.turn.yml) ----
# Relay hostname for participants on networks that block UDP / non-standard ports. Add a DNS A record pointing to the same public IP.
TURN_DOMAIN=turn.example.com
# Where Caddy stores the issued certificate (Let's Encrypt by default). If it was issued by ZeroSSL, change to .../acme.zerossl.com-v2-dv90
TURN_CERT_DIR=/caddy-data/caddy/certificates/acme-v02.api.letsencrypt.org-directory
