# MeetFlow server with an IP address only (HTTPS on the IP) — the web app/API and LiveKit signaling share 443, split by path.
{
	# Host port 80 may be used by another web service, so leave it alone: no HTTP→HTTPS redirect and no http-01 challenge.
	auto_https disable_redirects
	# Browsers send no SNI when connecting to an IP, and inside the container the destination IP is not the public IP → set the default certificate
	default_sni {$PUBLIC_HOST}
}

(tls-internal) {
	tls internal
}

(tls-public) {
	tls {
		issuer acme {
			profile shortlived
			disable_http_challenge
		}
	}
}

https://{$PUBLIC_HOST} {
	import tls-{$TLS_MODE}
	encode zstd gzip

	# livekit-client only uses <url>/rtc (WebSocket) and <url>/rtc/validate
	@livekit path /rtc /rtc/*
	handle @livekit {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy backend:3000
	}
}
