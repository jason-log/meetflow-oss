# MeetFlow edge — routes 443/tcp by TLS SNI (TLS is passed through, not terminated)
worker_processes auto;
events { worker_connections 4096; }

stream {
    map $ssl_preread_server_name $mf_upstream {
        ${TURN_DOMAIN}  livekit:443;
        default         caddy:443;
    }

    resolver 127.0.0.11 valid=30s ipv6=off;   # Docker's embedded DNS (handles IP changes after container restarts)

    server {
        listen 443;
        ssl_preread on;
        proxy_pass $mf_upstream;
        proxy_protocol on;             # pass the real client IP (caddy and livekit TURN are both configured to accept it)
        proxy_connect_timeout 5s;
        proxy_timeout 2h;              # keep long-lived TURN connections open during a meeting
    }
}
