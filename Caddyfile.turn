# TURN 확장 구성용 Caddyfile — edge(nginx) 뒤에서 443 을 받는다.
{
	servers :443 {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 172.16.0.0/12 10.0.0.0/8 192.168.0.0/16
			}
			tls
		}
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:3000
}

{$LIVEKIT_DOMAIN} {
	reverse_proxy livekit:7880
}

# TURN 도메인: 인증서 발급·갱신용(실제 TURN 트래픽은 edge 가 livekit 으로 보낸다)
{$TURN_DOMAIN} {
	respond "MeetFlow TURN" 200
}
