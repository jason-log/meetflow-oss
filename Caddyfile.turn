# Caddyfile for the TURN extension — receives 443 from behind edge (nginx).
{
	servers :443 {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 172.16.0.0/12 10.0.0.0/8 192.168.0.0/16
			}
			tls
		}
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:3000
}

{$LIVEKIT_DOMAIN} {
	reverse_proxy livekit:7880
}

# TURN hostname: only for issuing/renewing its certificate (actual TURN traffic goes from edge to livekit)
{$TURN_DOMAIN} {
	respond "MeetFlow TURN" 200
}
